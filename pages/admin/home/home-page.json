{
  "type": "page",
  "name": "home-page",
  "body": [
    {
      "type": "crud",
      "interval": 10000,
      "headerToolbar": [
        {
          "type": "reload",
          "align": "left",
          "icon": "iconfont icon-refresh",
          "label": "刷新",
          "tooltip": "",
          "level": "primary"
        }
      ],
      "api": {
        "url": "${API_HOST}/metric/usage",
        "method": "get"
      },
      "columns": [
        {
          "name": "name",
          "label": "name",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "cpu",
          "label": "cpu占用率",
          "type": "progress",
          "map": ["bg-info", "bg-success","bg-warning","bg-danger"],
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "memory",
          "label": "内存占用率",
          "type": "progress",
          "map": ["bg-info", "bg-success","bg-warning","bg-danger"],
          "labelClassName": "font-bold",
          "align": "center"
        }
      ]
    }
  ]
}