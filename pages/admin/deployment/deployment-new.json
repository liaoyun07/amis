{
  "type": "page",
  "title": "创建Deployment",
  "remark": null,
  "toolbar": [
    {
      "type": "button",
      "actionType": "link",
      "link": "/deployment",
      "label": "返回Deployment列表",
      "level": "primary"
    }
  ],
  "preventEnterSubmit": true,
  "body": [
    {
      "type": "json",
      "jsonTheme": "eighties",
      "levelExpand": 1,
      "value": {
        "说明": "以下json是一个示例",
        "metadata": {
          "name": "tcp-deployment",
          "namespace": "test",
          "labels": {
            "tcp-app": "tcp-python-app"
          }
        },
        "spec": {
          "replicas": 3,
          "selector": {
            "matchLabels": {
              "tcp-app": "tcp-python-app"
            }
          },
          "template": {
            "metadata": {
              "labels": {
                "tcp-app": "tcp-python-app"
              }
            },
            "spec": {
              "containers": [
                {
                  "name": "tcp-app",
                  "image": "192.168.3.151:5000/tcp",
                  "ports": [
                    {
                      "containerPort": 9999,
                      "protocol": "TCP"
                    }
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "type": "form",
      "api": {
        "method": "post",
        "url": "${API_HOST}/deployment/add"
      },
      "debug": true,
      "redirect": "/deployment",
      "actions": [
        {
          "type": "submit",
          "label": "创建",
          "level": "primary"
        }
      ],
      "body": [
        {
          "type": "json-schema",
          "name": "metadata",
          "label": "metadata",
          "labelRemark": {
            "content": "labels可添加多个",
            "placement": "top"
          },
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "name",
              "labels"
            ],
            "properties":{
              "name": {
                "type": "string",
                "title": "name"
              },
              "namespace": {
                "type": "string",
                "title": "namespace"
              },
              "labels": {
                "type": "object",
                "title": "labels",
                "additionalProperties": true
              }
            }
          }
        },
        {
          "type": "json-schema",
          "name": "spec",
          "label": "spec",
          "labelRemark": {
            "content": "可参照示例进行创建",
            "placement": "top"
          },
          "schema": {
            "type": "object",
            "title": "spec",
            "required": [
              "replicas",
              "selector",
              "template"
            ],
            "additionalProperties": false,
            "properties":{
              "replicas": {
                "type": "number",
                "title": "replicas"
              },
              "selector": {
                "type": "object",
                "title": "selector",
                "required": [
                  "matchLabels"
                ],
                "additionalProperties": true,
                "properties":{
                  "matchLabels": {
                    "type": "object",
                    "title": "matchLabels",
                    "properties": {
                    }
                  }
                }
              },
              "template": {
                "type": "object",
                "title": "template",
                "required": [
                  "metadata",
                  "spec"
                ],
                "additionalProperties": false,
                "properties": {
                  "metadata": {
                    "type": "object",
                    "title": "metadata",
                    "additionalProperties": false,
                    "required": [
                      "labels"
                    ],
                    "properties": {
                      "labels": {
                        "type": "object",
                        "title": "labels",
                        "additionalProperties": true
                      }
                    }
                  },
                  "spec": {
                    "type": "object",
                    "title": "spec",
                    "required": [
                      "containers"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "containers": {
                        "type": "array",
                        "title": "containers",
                        "additionalProperties": true,
                        "items": {
                          "type": "object",
                          "required": [
                            "name",
                            "image",
                            "ports"
                          ],
                          "properties": {
                            "name": {
                              "type": "string",
                              "title": "name"
                            },
                            "image": {
                              "type": "string",
                              "title": "image"
                            },
                            "ports": {
                              "type": "array",
                              "title": "ports",
                              "additionalProperties": true,
                              "items": {
                                "type": "object",
                                "required": [
                                  "containerPort",
                                  "protocol"
                                ],
                                "properties": {
                                  "containerPort": {
                                    "type": "number",
                                    "title": "containerPort"
                                  },
                                  "protocol": {
                                    "type": "string",
                                    "title": "protocol"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
