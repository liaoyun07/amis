{
  "type": "page",
  "name": "terminal-devices",
  "title": "终端设备接入",
  "body": [
    {
      "type": "crud",
      "name": "terminal-device-list",
      "api": {
        "method": "get",
        "url": "${API_HOST}/datastream/terminal/devices",
        "adaptor": "return {...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: {items: payload.data || []}};"
      },
      "interval": 5000,
      "silentPolling": true,
      "headerToolbar": [
        {
          "type": "reload",
          "label": "刷新",
          "level": "primary"
        }
      ],
      "columns": [
        {
          "name": "terminalCode",
          "label": "终端编号"
        },
        {
          "name": "clusterCode",
          "label": "所属边缘云"
        },
        {
          "name": "deviceType",
          "label": "设备类型"
        },
        {
          "name": "status",
          "label": "状态",
          "type": "mapping",
          "map": {
            "在线": "<span class='label label-success'>在线</span>",
            "离线": "<span class='label label-default'>离线</span>",
            "ONLINE": "<span class='label label-success'>在线</span>",
            "OFFLINE": "<span class='label label-default'>离线</span>",
            "鍦ㄧ嚎": "<span class='label label-success'>在线</span>",
            "绂荤嚎": "<span class='label label-default'>离线</span>",
            "*": "${status}"
          }
        },
        {
          "name": "cpuLoad",
          "label": "终端负载",
          "type": "tpl",
          "tpl": "${cpuLoad || 0}%"
        },
        {
          "name": "batteryLevel",
          "label": "电量",
          "type": "tpl",
          "tpl": "${batteryLevel || 0}%"
        },
        {
          "name": "sampleIntervalSeconds",
          "label": "采集周期",
          "type": "tpl",
          "tpl": "${sampleIntervalSeconds || '-'} 秒"
        },
        {
          "name": "uploadCount",
          "label": "第一数据数"
        },
        {
          "name": "resultCount",
          "label": "接收结果数"
        },
        {
          "name": "lastHeartbeatAt",
          "label": "最近心跳"
        },
        {
          "name": "lastUploadAt",
          "label": "最近数据"
        }
      ],
      "placeholder": "暂无终端设备"
    }
  ]
}
