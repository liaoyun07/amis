{
  "type": "page",
  "name": "data-records",
  "title": "\u6570\u636e\u6d41\u8f6c\u8bb0\u5f55",
  "body": [
    {
      "type": "crud",
      "name": "data-flow-record-list",
      "filter": {
        "title": "",
        "mode": "horizontal",
        "wrapWithPanel": false,
        "body": [
          {
            "type": "input-text",
            "name": "taskName",
            "label": "\u5173\u952e\u8bcd",
            "placeholder": "\u6d41\u4efb\u52a1 / \u7b56\u7565 / \u7ec8\u7aef",
            "clearable": true
          }
        ]
      },
      "api": {
        "method": "get",
        "url": "${API_HOST}/datastream/data-record/flow-list",
        "data": {
          "taskName": "${taskName}",
          "page": "${page}",
          "perPage": "${perPage}"
        },
        "adaptor": "var body = payload.data || {}; return {...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: {items: body.items || [], total: body.total || 0}};"
      },
      "perPage": 20,
      "perPageAvailable": [10, 20, 50],
      "columns": [
        {"name": "createdAt", "label": "\u767b\u8bb0\u65f6\u95f4"},
        {"name": "sourceTerminal", "label": "\u6765\u6e90\u7ec8\u7aef"},
        {"name": "clusterCode", "label": "\u6240\u5c5e\u8fb9\u7f18\u4e91"},
        {"name": "policyName", "label": "\u89e6\u53d1\u7b56\u7565"},
        {"name": "processorImage", "label": "\u5904\u7406\u5e94\u7528"},
        {"name": "outputTargetName", "label": "\u7b2c\u4e8c\u6570\u636e\u53bb\u5411"},
        {"name": "processStatus", "label": "\u5904\u7406\u72b6\u6001"},
        {
          "type": "operation",
          "label": "\u8be6\u60c5",
          "buttons": [
            {
              "type": "button",
              "label": "\u67e5\u770b",
              "level": "link",
              "actionType": "dialog",
              "dialog": {
                "title": "\u6570\u636e\u6d41\u8f6c\u8be6\u60c5",
                "body": {
                  "type": "property",
                  "items": [
                    {"label": "\u7b2c\u4e00\u6570\u636e\u8def\u5f84", "content": "${inputPath || '-'}"},
                    {"label": "\u7b2c\u4e8c\u6570\u636e\u8def\u5f84", "content": "${outputPath || '-'}"},
                    {"label": "\u89e6\u53d1\u6d41\u4efb\u52a1", "content": "${flowTaskName || '-'}"}
                  ]
                }
              }
            }
          ]
        }
      ],
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "\u6682\u65e0\u6570\u636e\u6d41\u8f6c\u8bb0\u5f55"
    }
  ]
}
