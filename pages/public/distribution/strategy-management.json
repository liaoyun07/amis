{
  "type": "page",
  "name": "strategy-management",
  "title": "策略管理",
  "body": [
    {
      "type": "crud",
      "name": "app-catalog-list",
      "api": {
        "method": "get",
        "url": "${API_HOST}/datastream/app-catalog/list",
        "adaptor": "return {...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: {items: payload.data || []}};"
      },
      "headerToolbar": [
        {
          "type": "button",
          "label": "新增应用分发策略",
          "level": "primary",
          "actionType": "dialog",
          "dialog": {
            "title": "应用分发策略",
            "size": "md",
            "body": {
              "type": "form",
              "api": {
                "method": "post",
                "url": "${API_HOST}/datastream/app-catalog/save",
                "adaptor": "return {...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message};"
              },
              "body": [
                {
                  "type": "select",
                  "name": "appName",
                  "label": "应用名称",
                  "required": true,
                  "searchable": true,
                  "placeholder": "请选择已登记的应用",
                  "labelField": "label",
                  "valueField": "value",
                  "source": {
                    "method": "get",
                    "url": "${API_HOST}/datastream/app-catalog/options",
                    "adaptor": "return {status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: {options: payload.data || []}};"
                  }
                },
                {
                  "type": "input-text",
                  "name": "version",
                  "label": "版本",
                  "value": "latest",
                  "placeholder": "latest"
                },
                {
                  "type": "select",
                  "name": "dispatchMode",
                  "label": "分发方式",
                  "value": "on_demand",
                  "options": [
                    { "label": "按需分发", "value": "on_demand" },
                    { "label": "启动前预分发", "value": "preload" },
                    { "label": "广播到全部边缘", "value": "broadcast" }
                  ]
                },
                {
                  "type": "select",
                  "name": "targetScope",
                  "label": "目标范围",
                  "value": "participating",
                  "options": [
                    { "label": "本次参与边缘", "value": "participating" },
                    { "label": "全部边缘", "value": "all_edges" },
                    { "label": "指定边缘", "value": "explicit" }
                  ]
                },
                {
                  "type": "input-text",
                  "name": "targetClusters",
                  "label": "指定边缘",
                  "placeholder": "edge-a,edge-b",
                  "visibleOn": "${targetScope === 'explicit'}"
                },
                {
                  "type": "textarea",
                  "name": "triggerCondition",
                  "label": "触发说明",
                  "minRows": 2,
                  "placeholder": "例如：任务启动前预分发到参与训练的边缘云"
                },
                {
                  "type": "switch",
                  "name": "enabled",
                  "label": "启用",
                  "value": true
                }
              ]
            }
          }
        },
        { "type": "reload", "label": "刷新", "level": "primary" }
      ],
      "columns": [
        { "name": "appName", "label": "应用" },
        { "name": "version", "label": "版本" },
        { "name": "dispatchMode", "label": "分发方式" },
        { "name": "targetScope", "label": "目标范围" },
        { "name": "targetClusters", "label": "指定边缘" },
        { "name": "triggerCondition", "label": "触发说明", "breakpoint": "*" },
        { "name": "image", "label": "中心镜像", "breakpoint": "*" },
        { "name": "enabled", "label": "启用", "type": "status" },
        { "name": "updatedAt", "label": "更新时间" },
        {
          "type": "operation",
          "label": "操作",
          "buttons": [
            {
              "type": "button",
              "label": "编辑策略",
              "level": "link",
              "actionType": "dialog",
              "dialog": {
                "title": "编辑应用分发策略",
                "size": "md",
                "body": {
                  "type": "form",
                  "api": {
                    "method": "post",
                    "url": "${API_HOST}/datastream/app-catalog/save",
                    "adaptor": "return {...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message};"
                  },
                  "body": [
                    {
                      "type": "input-text",
                      "name": "appName",
                      "label": "应用名称",
                      "required": true,
                      "disabled": true
                    },
                    {
                      "type": "input-text",
                      "name": "version",
                      "label": "版本",
                      "placeholder": "latest"
                    },
                    {
                      "type": "static",
                      "name": "image",
                      "label": "中心镜像"
                    },
                    {
                      "type": "select",
                      "name": "dispatchMode",
                      "label": "分发方式",
                      "options": [
                        { "label": "按需分发", "value": "on_demand" },
                        { "label": "启动前预分发", "value": "preload" },
                        { "label": "广播到全部边缘", "value": "broadcast" }
                      ]
                    },
                    {
                      "type": "select",
                      "name": "targetScope",
                      "label": "目标范围",
                      "options": [
                        { "label": "本次参与边缘", "value": "participating" },
                        { "label": "全部边缘", "value": "all_edges" },
                        { "label": "指定边缘", "value": "explicit" }
                      ]
                    },
                    {
                      "type": "input-text",
                      "name": "targetClusters",
                      "label": "指定边缘",
                      "visibleOn": "${targetScope === 'explicit'}"
                    },
                    {
                      "type": "textarea",
                      "name": "triggerCondition",
                      "label": "触发说明",
                      "minRows": 2
                    },
                    {
                      "type": "switch",
                      "name": "enabled",
                      "label": "启用"
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "删除",
              "level": "link",
              "className": "text-danger",
              "actionType": "ajax",
              "confirmText": "确认删除应用策略 ${appName} ?",
              "api": {
                "method": "get",
                "url": "${API_HOST}/datastream/app-catalog/delete?appName=${appName}",
                "adaptor": "return {...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message};"
              }
            }
          ]
        }
      ],
      "affixHeader": true,
      "columnsTogglable": "auto"
    }
  ]
}
