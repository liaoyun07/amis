{
  "type": "page",
  "name": "application-inventory",
  "title": "\u5e94\u7528\u5e93\u5b58",
  "body": [
    {
      "type": "crud",
      "name": "application-inventory-list",
      "data": {
        "clusterCode": "cloud-main"
      },
      "filter": {
        "title": "",
        "mode": "horizontal",
        "wrapWithPanel": false,
        "submitText": "\u67e5\u770b",
        "body": [
          {
            "type": "select",
            "name": "clusterCode",
            "label": "\u4e91\u73af\u5883",
            "value": "cloud-main",
            "clearable": false,
            "searchable": false,
            "submitOnChange": true,
            "source": {
              "method": "get",
              "url": "${API_HOST}/cluster/options"
            }
          }
        ]
      },
      "headerToolbar": [
        { "type": "reload", "align": "left", "icon": "iconfont icon-refresh", "label": "\u5237\u65b0", "level": "primary" },
        { "type": "columns-toggler", "align": "right", "icon": "fas fa-cog", "overlay": true }
      ],
      "api": {
        "url": "${API_HOST}/distribution/inventory",
        "method": "get",
        "data": {
          "clusterCode": "${clusterCode}"
        }
      },
      "columns": [
        { "name": "appName", "label": "\u5e94\u7528", "align": "center" },
        { "name": "image", "label": "\u955c\u50cf", "align": "center" },
        { "name": "version", "label": "\u7248\u672c", "align": "center" },
        { "name": "clusterCode", "label": "\u5b58\u50a8\u4f4d\u7f6e", "align": "center" },
        {
          "name": "clusterRole",
          "label": "\u89d2\u8272",
          "type": "mapping",
          "map": {
            "CLOUD": "\u4e2d\u5fc3\u4e91",
            "EDGE": "\u8fb9\u7f18\u4e91",
            "GENERAL": "\u901a\u7528\u96c6\u7fa4",
            "*": "${clusterRole}"
          },
          "align": "center"
        },
        { "name": "repository", "label": "\u4ed3\u5e93", "align": "center" },
        { "name": "digest", "label": "\u955c\u50cf\u6458\u8981", "align": "center", "breakpoint": "*" },
        { "name": "storageType", "label": "\u5b58\u50a8\u7c7b\u578b", "align": "center" },
        {
          "name": "status",
          "label": "\u72b6\u6001",
          "type": "mapping",
          "map": {
            "READY": "<span class='label label-success'>READY</span>",
            "DISTRIBUTING": "<span class='label label-warning'>DISTRIBUTING</span>",
            "*": "<span class='label label-default'>${status}</span>"
          },
          "align": "center"
        },
        { "name": "storedAt", "label": "\u5165\u5e93\u65f6\u95f4", "align": "center" }
      ],
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "\u5f53\u524d\u4e91\u73af\u5883\u6682\u65e0\u5e94\u7528\u5e93\u5b58",
      "tableClassName": "table-db table-striped"
    }
  ]
}
