{
  "type": "page",
  "name": "home-page",
  "title": "\u96c6\u7fa4\u6982\u51b5",
  "body": [
    {
      "type": "crud",
      "interval": 10000,
      "syncLocation": false,
      "headerToolbar": [
        {
          "type": "reload",
          "align": "left",
          "icon": "iconfont icon-refresh",
          "label": "\u5237\u65b0",
          "level": "primary"
        }
      ],
      "api": {
        "url": "${API_HOST}/metric/cluster/overview",
        "method": "get"
      },
      "columns": [
        {
          "name": "clusterCode",
          "label": "\u96c6\u7fa4",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "clusterRole",
          "label": "\u89d2\u8272",
          "type": "mapping",
          "map": {
            "CLOUD": "\u4e2d\u5fc3\u4e91",
            "EDGE": "\u8fb9\u7f18\u4e91",
            "GENERAL": "\u901a\u7528\u96c6\u7fa4",
            "*": "${clusterRole}"
          },
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "name",
          "label": "\u8282\u70b9",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "status",
          "label": "\u72b6\u6001",
          "type": "mapping",
          "map": {
            "READY": "<span class='label label-success'>READY</span>",
            "NOT_READY": "<span class='label label-warning'>NOT_READY</span>",
            "UNAVAILABLE": "<span class='label label-danger'>UNAVAILABLE</span>",
            "*": "<span class='label label-default'>${status}</span>"
          },
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "ip",
          "label": "\u8282\u70b9 IP",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "cpu",
          "label": "CPU \u4f7f\u7528\u7387",
          "type": "progress",
          "map": ["bg-info", "bg-success", "bg-warning", "bg-danger"],
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "cpuUsedText",
          "label": "CPU \u5df2\u7528",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "cpuAllocatableText",
          "label": "CPU \u53ef\u5206\u914d",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "memory",
          "label": "\u5185\u5b58\u4f7f\u7528\u7387",
          "type": "progress",
          "map": ["bg-info", "bg-success", "bg-warning", "bg-danger"],
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "memoryUsedText",
          "label": "\u5185\u5b58\u5df2\u7528",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "memoryAllocatableText",
          "label": "\u5185\u5b58\u53ef\u5206\u914d",
          "labelClassName": "font-bold",
          "align": "center"
        }
      ]
    }
  ]
}
