{
  "type": "page",
  "name": "home-page",
  "body": [
    {
      "type": "crud",
      "interval": 10000,
      "headerToolbar": [
        {
          "type": "reload",
          "align": "left",
          "icon": "iconfont icon-refresh",
          "label": "刷新",
          "tooltip": "",
          "level": "primary"
        }
      ],
      "api": {
        "url": "${API_HOST}/metric/usage",
        "method": "get"
      },
      "columns": [
        {
          "name": "name",
          "label": "Node",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "cpu",
          "label": "CPU使用率",
          "type": "progress",
          "map": ["bg-info", "bg-success", "bg-warning", "bg-danger"],
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "cpuUsedText",
          "label": "CPU已用",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "cpuAllocatableText",
          "label": "CPU可分配",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "cpuCapacityText",
          "label": "CPU总量",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "memory",
          "label": "内存使用率",
          "type": "progress",
          "map": ["bg-info", "bg-success", "bg-warning", "bg-danger"],
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "memoryUsedText",
          "label": "内存已用",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "memoryAllocatableText",
          "label": "内存可分配",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "memoryCapacityText",
          "label": "内存总量",
          "labelClassName": "font-bold",
          "align": "center"
        }
      ]
    }
  ]
}
