{
  "type": "page",
  "title": "流控制中心",
  "body": [
    {
      "type": "crud",
      "name": "flow-task-list",
      "syncLocation": false,
      "api": {
        "method": "get",
        "url": "${API_HOST}/datastream/flow/task/list",
        "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: { items: payload.data || [] } };"
      },
      "headerToolbar": [
        {
          "type": "reload",
          "label": "刷新",
          "level": "primary"
        }
      ],
      "columns": [
        {
          "name": "taskName",
          "label": "任务名称",
          "align": "center"
        },
        {
          "name": "templateName",
          "label": "模板",
          "align": "center"
        },
        {
          "name": "namespace",
          "label": "命名空间",
          "align": "center"
        },
        {
          "name": "workflowName",
          "label": "Workflow",
          "align": "center"
        },
        {
          "name": "status",
          "label": "状态",
          "align": "center",
          "type": "mapping",
          "map": {
            "SUBMITTED": "<span class='label label-info'>SUBMITTED</span>",
            "PENDING": "<span class='label label-warning'>PENDING</span>",
            "RUNNING": "<span class='label label-success'>RUNNING</span>",
            "SUCCEEDED": "<span class='label label-default'>SUCCEEDED</span>",
            "FAILED": "<span class='label label-danger'>FAILED</span>",
            "ERROR": "<span class='label label-danger'>ERROR</span>",
            "UNKNOWN": "<span class='label label-warning'>UNKNOWN</span>",
            "*": "${status}"
          }
        },
        {
          "name": "createdAt",
          "label": "创建时间",
          "align": "center"
        },
        {
          "name": "totalDurationMs",
          "label": "总耗时(ms)",
          "align": "center"
        },
        {
          "type": "operation",
          "label": "操作",
          "align": "center",
          "buttons": [
            {
              "type": "button",
              "label": "详情",
              "level": "primary",
              "actionType": "dialog",
              "dialog": {
                "title": "流任务详情 - ${taskName}",
                "size": "xl",
                "body": {
                  "type": "service",
                  "api": {
                    "method": "get",
                    "url": "${API_HOST}/datastream/flow/task/detail?taskName=${taskName}",
                    "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: payload.data || {} };"
                  },
                  "body": [
                    {
                      "type": "grid",
                      "columns": [
                        {
                          "md": 2,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>状态</div><h3>${status|default:-}</h3></div>"
                          }
                        },
                        {
                          "md": 2,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>Workflow</div><h3>${workflowName|default:-}</h3></div>"
                          }
                        },
                        {
                          "md": 2,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>节点数</div><h3>${nodes.length || 0}</h3></div>"
                          }
                        },
                        {
                          "md": 2,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>等待耗时</div><h3>${waitingDurationMs|default:0} ms</h3></div>"
                          }
                        },
                        {
                          "md": 2,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>执行耗时</div><h3>${executionDurationMs|default:0} ms</h3></div>"
                          }
                        },
                        {
                          "md": 2,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>任务总耗时</div><h3>${totalDurationMs|default:0} ms</h3></div>"
                          }
                        }
                      ]
                    },
                    {
                      "type": "divider",
                      "title": "节点状态"
                    },
                    {
                      "type": "table",
                      "source": "${nodes}",
                      "placeholder": "暂无节点状态，Workflow 可能尚未开始调度。",
                      "columns": [
                        {
                          "name": "displayName",
                          "label": "节点"
                        },
                        {
                          "name": "type",
                          "label": "类型"
                        },
                        {
                          "name": "phase",
                          "label": "阶段",
                          "type": "mapping",
                          "map": {
                            "Pending": "<span class='label label-warning'>Pending</span>",
                            "Running": "<span class='label label-success'>Running</span>",
                            "Succeeded": "<span class='label label-default'>Succeeded</span>",
                            "Failed": "<span class='label label-danger'>Failed</span>",
                            "Error": "<span class='label label-danger'>Error</span>",
                            "*": "${phase}"
                          }
                        },
                        {
                          "name": "podName",
                          "label": "Pod"
                        },
                        {
                          "name": "message",
                          "label": "信息"
                        },
                        {
                          "name": "startedAt",
                          "label": "开始时间"
                        },
                        {
                          "name": "finishedAt",
                          "label": "结束时间"
                        },
                        {
                          "name": "waitingDurationMs",
                          "label": "等待耗时(ms)"
                        },
                        {
                          "name": "executionDurationMs",
                          "label": "执行耗时(ms)"
                        },
                        {
                          "name": "totalDurationMs",
                          "label": "总耗时(ms)"
                        },
                        {
                          "name": "executionCount",
                          "label": "执行次数"
                        },
                        {
                          "type": "operation",
                          "label": "操作",
                          "buttons": [
                            {
                              "type": "button",
                              "label": "日志",
                              "level": "link",
                              "visibleOn": "this.podName",
                              "actionType": "dialog",
                              "dialog": {
                                "title": "Pod 日志 - ${podName}",
                                "size": "lg",
                                "body": {
                                  "type": "service",
                                  "api": {
                                    "method": "get",
                                    "url": "${API_HOST}/datastream/flow/task/log?taskName=${taskName}&podName=${podName}&tailLines=200",
                                    "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: { log: payload.data || '' } };"
                                  },
                                  "body": {
                                    "type": "tpl",
                                    "tpl": "<pre style='white-space: pre-wrap; max-height: 520px; overflow: auto;'>${log}</pre>"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "结果",
              "level": "info",
              "actionType": "dialog",
              "dialog": {
                "title": "Workflow 结果 - ${taskName}",
                "size": "lg",
                "body": {
                  "type": "service",
                  "api": {
                    "method": "get",
                    "url": "${API_HOST}/datastream/flow/task/result?taskName=${taskName}",
                    "adaptor": "const data = payload.data || {};\nconst rows = data.metricRows || [];\nconst labels = rows.map(item => `Round ${item.round}`);\ndata.lossChart = { tooltip: { trigger: 'axis' }, grid: { left: 56, right: 24, bottom: 36, top: 36 }, xAxis: { type: 'category', boundaryGap: false, data: labels }, yAxis: { type: 'value', name: 'Loss', scale: true }, series: [{ name: 'Average Loss', type: 'line', smooth: true, symbolSize: 7, data: rows.map(item => item.avgLoss) }] };\ndata.accuracyChart = { tooltip: { trigger: 'axis' }, grid: { left: 56, right: 24, bottom: 36, top: 36 }, xAxis: { type: 'category', boundaryGap: false, data: labels }, yAxis: { type: 'value', name: 'Accuracy', min: 0, max: 1 }, series: [{ name: 'Average Accuracy', type: 'line', smooth: true, symbolSize: 7, data: rows.map(item => item.avgAccuracy) }] };\nconst summary = { status: data.status, message: data.message, plannedRounds: data.plannedRounds, completedRounds: data.completedRounds, currentRound: data.currentRound, finalModelPath: data.finalModelPath, finalModelObject: data.finalModelObject || null, artifactPrefix: data.artifactPrefix, artifactObjects: data.artifactObjects || [], metricRows: data.metricRows || [], artifactListError: data.artifactListError || null, finalModelError: data.finalModelError || null };\ndata.result = JSON.stringify(summary, null, 2);\nreturn { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data };"
                  },
                  "body": [
                    {
                      "type": "grid",
                      "columns": [
                        {
                          "md": 4,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>Status</div><h3>${status|default:-}</h3></div>"
                          }
                        },
                        {
                          "md": 4,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>Rounds</div><h3>${currentRound|default:0} / ${rounds|default:0}</h3></div>"
                          }
                        },
                        {
                          "md": 4,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>Final Model</div><div style='word-break: break-all;'>${finalModelPath|default:-}</div></div>"
                          }
                        }
                      ]
                    },
                    {
                      "type": "divider",
                      "title": "Loss"
                    },
                    {
                      "type": "chart",
                      "height": 280,
                      "source": "${lossChart}",
                      "placeholder": "No loss metrics"
                    },
                    {
                      "type": "divider",
                      "title": "Accuracy"
                    },
                    {
                      "type": "chart",
                      "height": 280,
                      "source": "${accuracyChart}",
                      "placeholder": "No accuracy metrics"
                    },
                    {
                      "type": "table",
                      "source": "${metricRows}",
                      "placeholder": "No metric rows",
                      "columns": [
                        {
                          "name": "round",
                          "label": "Round"
                        },
                        {
                          "name": "avgLoss",
                          "label": "Avg Loss"
                        },
                        {
                          "name": "avgAccuracy",
                          "label": "Avg Accuracy"
                        },
                        {
                          "name": "samples",
                          "label": "Samples"
                        },
                        {
                          "name": "clients",
                          "label": "Clients",
                          "type": "json"
                        }
                      ]
                    },
                    {
                      "type": "divider",
                      "title": "Raw Result"
                    },
                    {
                      "type": "tpl",
                      "tpl": "<pre style='white-space: pre-wrap; max-height: 520px; overflow: auto;'>${result}</pre>"
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "删除",
              "level": "danger",
              "actionType": "ajax",
              "confirmText": "确认删除任务 ${taskName} 并清理 Workflow/Service/Deployment？",
              "api": {
                "method": "get",
                "url": "${API_HOST}/datastream/flow/task/delete?taskName=${taskName}",
                "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: payload.data };"
              },
              "reload": "flow-task-list"
            }
          ]
        }
      ]
    }
  ]
}
