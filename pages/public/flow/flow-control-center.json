{
  "type": "page",
  "title": "流控制中心",
  "body": [
    {
      "type": "crud",
      "name": "flow-task-list",
      "syncLocation": false,
      "api": {
        "method": "get",
        "url": "${API_HOST}/datastream/flow/task/list",
        "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: { items: payload.data || [] } };"
      },
      "headerToolbar": [
        {
          "type": "reload",
          "label": "刷新",
          "level": "primary"
        }
      ],
      "columns": [
        {
          "name": "taskName",
          "label": "任务名称",
          "align": "center"
        },
        {
          "name": "templateName",
          "label": "模板",
          "align": "center"
        },
        {
          "name": "namespace",
          "label": "命名空间",
          "align": "center"
        },
        {
          "name": "workflowName",
          "label": "Workflow",
          "align": "center"
        },
        {
          "name": "status",
          "label": "状态",
          "align": "center",
          "type": "mapping",
          "map": {
            "SUBMITTED": "<span class='label label-info'>SUBMITTED</span>",
            "PENDING": "<span class='label label-warning'>PENDING</span>",
            "RUNNING": "<span class='label label-success'>RUNNING</span>",
            "SUCCEEDED": "<span class='label label-default'>SUCCEEDED</span>",
            "FAILED": "<span class='label label-danger'>FAILED</span>",
            "ERROR": "<span class='label label-danger'>ERROR</span>",
            "UNKNOWN": "<span class='label label-warning'>UNKNOWN</span>",
            "*": "${status}"
          }
        },
        {
          "name": "createdAt",
          "label": "创建时间",
          "align": "center"
        },
        {
          "type": "operation",
          "label": "操作",
          "align": "center",
          "buttons": [
            {
              "type": "button",
              "label": "详情",
              "level": "primary",
              "actionType": "dialog",
              "dialog": {
                "title": "流任务详情 - ${taskName}",
                "size": "xl",
                "body": {
                  "type": "service",
                  "api": {
                    "method": "get",
                    "url": "${API_HOST}/datastream/flow/task/detail?taskName=${taskName}",
                    "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: payload.data || {} };"
                  },
                  "body": [
                    {
                      "type": "grid",
                      "columns": [
                        {
                          "md": 3,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>状态</div><h3>${status|default:-}</h3></div>"
                          }
                        },
                        {
                          "md": 3,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>Runtime</div><h3>${runtime|default:ARGO}</h3></div>"
                          }
                        },
                        {
                          "md": 3,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>Workflow</div><h3>${workflowName|default:-}</h3></div>"
                          }
                        },
                        {
                          "md": 3,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>节点数</div><h3>${nodes.length || 0}</h3></div>"
                          }
                        }
                      ]
                    },
                    {
                      "type": "divider",
                      "title": "节点状态"
                    },
                    {
                      "type": "table",
                      "source": "${nodes}",
                      "placeholder": "暂无节点状态，Workflow 可能尚未开始调度。",
                      "columns": [
                        { "name": "displayName", "label": "节点" },
                        { "name": "type", "label": "类型" },
                        {
                          "name": "phase",
                          "label": "阶段",
                          "type": "mapping",
                          "map": {
                            "Pending": "<span class='label label-warning'>Pending</span>",
                            "Running": "<span class='label label-success'>Running</span>",
                            "Succeeded": "<span class='label label-default'>Succeeded</span>",
                            "Failed": "<span class='label label-danger'>Failed</span>",
                            "Error": "<span class='label label-danger'>Error</span>",
                            "*": "${phase}"
                          }
                        },
                        { "name": "podName", "label": "Pod" },
                        { "name": "message", "label": "信息" },
                        { "name": "startedAt", "label": "开始时间" },
                        { "name": "finishedAt", "label": "结束时间" },
                        {
                          "type": "operation",
                          "label": "操作",
                          "buttons": [
                            {
                              "type": "button",
                              "label": "日志",
                              "level": "link",
                              "visibleOn": "this.podName",
                              "actionType": "dialog",
                              "dialog": {
                                "title": "Pod 日志 - ${podName}",
                                "size": "lg",
                                "body": {
                                  "type": "service",
                                  "api": {
                                    "method": "get",
                                    "url": "${API_HOST}/datastream/flow/task/log?taskName=${taskName}&podName=${podName}&tailLines=200",
                                    "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: { log: payload.data || '' } };"
                                  },
                                  "body": {
                                    "type": "tpl",
                                    "tpl": "<pre style='white-space: pre-wrap; max-height: 520px; overflow: auto;'>${log}</pre>"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "结果",
              "level": "info",
              "actionType": "dialog",
              "dialog": {
                "title": "Workflow 结果 - ${taskName}",
                "size": "lg",
                "body": {
                  "type": "service",
                  "api": {
                    "method": "get",
                    "url": "${API_HOST}/datastream/flow/task/result?taskName=${taskName}",
                    "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: { result: JSON.stringify(payload.data || {}, null, 2) } };"
                  },
                  "body": {
                    "type": "tpl",
                    "tpl": "<pre style='white-space: pre-wrap; max-height: 520px; overflow: auto;'>${result}</pre>"
                  }
                }
              }
            },
            {
              "type": "button",
              "label": "删除",
              "level": "danger",
              "actionType": "ajax",
              "confirmText": "确认删除任务 ${taskName} 并清理 Workflow/Service/Deployment？",
              "api": {
                "method": "get",
                "url": "${API_HOST}/datastream/flow/task/delete?taskName=${taskName}",
                "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: payload.data };"
              },
              "reload": "flow-task-list"
            }
          ]
        }
      ]
    }
  ]
}
