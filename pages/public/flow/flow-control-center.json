{
  "type": "page",
  "title": "流任务运行监控",
  "body": [
    {
      "type": "crud",
      "name": "flow-task-list",
      "syncLocation": false,
      "api": {
        "method": "get",
        "url": "${API_HOST}/datastream/flow/task/list",
        "adaptor": "var items = (payload.data || []).map(function(item) { return { ...item, dataProcessingRate: item.dataProcessingRate || '-', resourceOverhead: item.resourceOverhead || '-' }; });\nreturn { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: { items: items } };"
      },
      "headerToolbar": [
        {
          "type": "reload",
          "label": "刷新",
          "level": "primary"
        }
      ],
      "columns": [
        {
          "name": "taskName",
          "label": "任务名称",
          "align": "center"
        },
        {
          "name": "templateName",
          "label": "模板",
          "align": "center"
        },
        {
          "name": "namespace",
          "label": "命名空间",
          "align": "center"
        },
        {
          "name": "workflowName",
          "label": "Workflow",
          "align": "center"
        },
        {
          "name": "status",
          "label": "状态",
          "align": "center",
          "type": "mapping",
          "map": {
            "SUBMITTED": "<span class='label label-info'>SUBMITTED</span>",
            "PENDING": "<span class='label label-warning'>PENDING</span>",
            "RUNNING": "<span class='label label-success'>RUNNING</span>",
            "SUCCEEDED": "<span class='label label-default'>SUCCEEDED</span>",
            "FAILED": "<span class='label label-danger'>FAILED</span>",
            "ERROR": "<span class='label label-danger'>ERROR</span>",
            "UNKNOWN": "<span class='label label-warning'>UNKNOWN</span>",
            "*": "${status}"
          }
        },
        {
          "name": "createdAt",
          "label": "创建时间",
          "align": "center"
        },
        {
          "name": "totalDurationMs",
          "label": "总耗时(ms)",
          "align": "center"
        },
        {
          "name": "dataProcessingRate",
          "label": "数据处理速率",
          "align": "center"
        },
        {
          "name": "resourceOverhead",
          "label": "系统资源开销",
          "align": "center"
        },
        {
          "type": "operation",
          "label": "操作",
          "align": "center",
          "buttons": [
            {
              "type": "button",
              "label": "子任务详情",
              "level": "primary",
              "actionType": "dialog",
              "dialog": {
                "title": "流任务详情 - ${taskName}",
                "size": "xl",
                "body": {
                  "type": "service",
                  "api": {
                    "method": "get",
                    "url": "${API_HOST}/datastream/flow/task/detail?taskName=${taskName}",
                    "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: payload.data || {} };"
                  },
                  "body": [
                    {
                      "type": "grid",
                      "columns": [
                        {
                          "md": 2,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>状态</div><h3>${status|default:-}</h3></div>"
                          }
                        },
                        {
                          "md": 2,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>Workflow</div><h3>${workflowName|default:-}</h3></div>"
                          }
                        },
                        {
                          "md": 2,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>节点数</div><h3>${nodes.length || 0}</h3></div>"
                          }
                        },
                        {
                          "md": 2,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>等待耗时</div><h3>${waitingDurationMs|default:0} ms</h3></div>"
                          }
                        },
                        {
                          "md": 2,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>执行耗时</div><h3>${executionDurationMs|default:0} ms</h3></div>"
                          }
                        },
                        {
                          "md": 2,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>任务总耗时</div><h3>${totalDurationMs|default:0} ms</h3></div>"
                          }
                        }
                      ]
                    },
                    {
                      "type": "divider",
                      "title": "节点状态"
                    },
                    {
                      "type": "table",
                      "source": "${nodes}",
                      "placeholder": "暂无节点状态，Workflow 可能尚未开始调度。",
                      "columns": [
                        {
                          "name": "displayName",
                          "label": "节点"
                        },
                        {
                          "name": "type",
                          "label": "类型"
                        },
                        {
                          "name": "phase",
                          "label": "阶段",
                          "type": "mapping",
                          "map": {
                            "Pending": "<span class='label label-warning'>Pending</span>",
                            "Running": "<span class='label label-success'>Running</span>",
                            "Succeeded": "<span class='label label-default'>Succeeded</span>",
                            "Failed": "<span class='label label-danger'>Failed</span>",
                            "Error": "<span class='label label-danger'>Error</span>",
                            "*": "${phase}"
                          }
                        },
                        {
                          "name": "podName",
                          "label": "Pod"
                        },
                        {
                          "name": "message",
                          "label": "信息"
                        },
                        {
                          "name": "startedAt",
                          "label": "开始时间"
                        },
                        {
                          "name": "finishedAt",
                          "label": "结束时间"
                        },
                        {
                          "name": "waitingDurationMs",
                          "label": "等待耗时(ms)"
                        },
                        {
                          "name": "executionDurationMs",
                          "label": "执行耗时(ms)"
                        },
                        {
                          "name": "totalDurationMs",
                          "label": "总耗时(ms)"
                        },
                        {
                          "name": "executionCount",
                          "label": "执行次数"
                        },
                        {
                          "type": "operation",
                          "label": "操作",
                          "buttons": [
                            {
                              "type": "button",
                              "label": "日志",
                              "level": "link",
                              "visibleOn": "this.podName",
                              "actionType": "dialog",
                              "dialog": {
                                "title": "Pod 日志 - ${podName}",
                                "size": "lg",
                                "body": {
                                  "type": "service",
                                  "api": {
                                    "method": "get",
                                    "url": "${API_HOST}/datastream/flow/task/log?taskName=${taskName}&podName=${podName}&tailLines=200",
                                    "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: { log: payload.data || '' } };"
                                  },
                                  "body": {
                                    "type": "tpl",
                                    "tpl": "<pre style='white-space: pre-wrap; max-height: 520px; overflow: auto;'>${log}</pre>"
                                  }
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "扩展结果展示",
              "level": "info",
              "actionType": "dialog",
              "dialog": {
                "title": "任务结果 - ${taskName}",
                "size": "lg",
                "data": {
                  "taskName": "${taskName}"
                },
                "dataMergeMode": "override",
                "body": {
                  "type": "service",
                  "name": "task-result-service-${taskName}",
                  "initFetch": true,
                  "api": {
                    "method": "get",
                    "url": "${API_HOST}/datastream/flow/task/result?taskName=${taskName}",
                    "adaptor": "const data = payload.data || {};\nconst result = data.taskResult || null;\ndata.taskResultTypeText = !result ? '无' : (result.type === 'LINE' ? '折线图' : (result.type === 'TEXT' ? '文本' : result.type));\nif (result && result.type === 'LINE' && result.data) {\n  const series = (result.data.series || []).map(item => ({ name: item.name || item.key || '指标', type: 'line', smooth: true, symbolSize: 7, data: item.data || [] }));\n  data.lineChart = { tooltip: { trigger: 'axis' }, legend: { top: 8 }, grid: { left: 56, right: 24, bottom: 36, top: 42 }, xAxis: { type: 'category', boundaryGap: false, data: result.data.xAxis || [] }, yAxis: { type: 'value', scale: true }, series: series };\n}\ndata.resultText = result && result.type === 'TEXT' && result.data ? result.data.content : '';\ndata.resultJson = result ? JSON.stringify(result, null, 2) : '';\nreturn { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: data };"
                  },
                  "body": [
                    {
                      "type": "grid",
                      "columns": [
                        {
                          "md": 4,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>任务状态</div><h3>${status|default:-}</h3></div>"
                          }
                        },
                        {
                          "md": 4,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>任务耗时</div><h3>${totalDurationMs|default:0} ms</h3></div>"
                          }
                        },
                        {
                          "md": 4,
                          "body": {
                            "type": "tpl",
                            "tpl": "<div class='b-a p-3'><div class='text-muted'>展示类型</div><h3>${taskResultTypeText|default:无}</h3></div>"
                          }
                        }
                      ]
                    },
                    {
                      "type": "divider",
                      "title": "扩展结果",
                      "visibleOn": "this.taskResult"
                    },
                    {
                      "type": "chart",
                      "height": 320,
                      "data": "${lineChart}",
                      "config": {
                        "tooltip": { "trigger": "axis" },
                        "legend": { "top": 8 },
                        "grid": { "left": 56, "right": 24, "bottom": 36, "top": 42 },
                        "xAxis": { "type": "category", "boundaryGap": false },
                        "yAxis": { "type": "value", "scale": true },
                        "series": []
                      },
                      "trackExpression": "${lineChart}",
                      "dataFilter": "config.xAxis.data = data.xAxis && data.xAxis.data ? data.xAxis.data : []; config.series = data.series || []; return config;",
                      "replaceChartOption": true,
                      "visibleOn": "this.taskResult && this.taskResult.type === 'LINE'",
                      "placeholder": "暂无折线图结果"
                    },
                    {
                      "type": "tpl",
                      "visibleOn": "this.taskResult && this.taskResult.type === 'TEXT'",
                      "tpl": "<pre style='white-space: pre-wrap; max-height: 520px; overflow: auto;'>${resultText|default:暂无文本结果}</pre>"
                    },
                    {
                      "type": "tpl",
                      "visibleOn": "!this.taskResult",
                      "tpl": "<div class='text-muted p-3'>当前任务未配置扩展结果，或尚未生成标准结果文件。</div>"
                    },
                    {
                      "type": "divider",
                      "title": "结果原文",
                      "visibleOn": "this.taskResult"
                    },
                    {
                      "type": "tpl",
                      "visibleOn": "this.taskResult",
                      "tpl": "<pre style='white-space: pre-wrap; max-height: 320px; overflow: auto;'>${resultJson}</pre>"
                    }
                  ]
                }
              }
            },
            {
              "type": "button",
              "label": "删除",
              "level": "danger",
              "actionType": "ajax",
              "confirmText": "确认删除任务 ${taskName} 并清理 Workflow/Service/Deployment？",
              "api": {
                "method": "get",
                "url": "${API_HOST}/datastream/flow/task/delete?taskName=${taskName}",
                "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: payload.data };"
              },
              "reload": "flow-task-list"
            }
          ]
        }
      ]
    }
  ]
}
