{
  "type": "page",
  "title": "Create Deployment",
  "remark": null,
  "toolbar": [
    {
      "type": "button",
      "actionType": "link",
      "link": "/deployment",
      "label": "Back To Deployment List",
      "level": "primary"
    }
  ],
  "body": [
    {
      "type": "alert",
      "level": "info",
      "showCloseButton": false,
      "body": "This form creates a minimal Deployment. If the image is selected from the image list, the image name will be filled automatically."
    },
    {
      "type": "form",
      "redirect": "/deployment",
      "api": {
        "method": "post",
        "url": "${API_HOST}/deployment/add",
        "data": {
          "metadata": {
            "name": "${deploymentName}",
            "namespace": "${namespace}",
            "labels": {
              "app": "${deploymentName}"
            }
          },
          "spec": {
            "replicas": "${replicas}",
            "selector": {
              "matchLabels": {
                "app": "${deploymentName}"
              }
            },
            "template": {
              "metadata": {
                "labels": {
                  "app": "${deploymentName}"
                }
              },
              "spec": {
                "containers": [
                  {
                    "name": "${deploymentName}",
                    "image": "${image}",
                    "ports": [
                      {
                        "containerPort": "${containerPort}",
                        "protocol": "TCP"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "actions": [
        {
          "type": "submit",
          "label": "Create",
          "level": "primary"
        }
      ],
      "body": [
        {
          "type": "input-text",
          "name": "deploymentName",
          "label": "Deployment Name",
          "required": true
        },
        {
          "type": "input-text",
          "name": "namespace",
          "label": "Namespace",
          "required": true
        },
        {
          "type": "input-text",
          "name": "image",
          "label": "Image",
          "value": "${params.image}",
          "required": true,
          "description": "You can enter a short image name like test or a full registry path."
        },
        {
          "type": "input-number",
          "name": "replicas",
          "label": "Replicas",
          "value": 1,
          "required": true
        },
        {
          "type": "input-number",
          "name": "containerPort",
          "label": "Container Port",
          "value": 8080,
          "required": true
        }
      ]
    }
  ]
}
