{
  "type": "page",
  "title": "\u521b\u5efa Deployment",
  "toolbar": [
    {
      "type": "button",
      "actionType": "link",
      "link": "/deployment",
      "label": "\u8fd4\u56de Deployment \u5217\u8868",
      "level": "primary"
    }
  ],
  "body": [
    {
      "type": "form",
      "redirect": "/deployment",
      "api": {
        "method": "post",
        "url": "${API_HOST}/deployment/add",
        "data": {
          "clusterCode": "${clusterCode}",
          "metadata": {
            "name": "${deploymentName}",
            "namespace": "${namespace}",
            "labels": {
              "app": "${deploymentName}"
            }
          },
          "spec": {
            "replicas": "${replicas}",
            "selector": {
              "matchLabels": {
                "app": "${deploymentName}"
              }
            },
            "template": {
              "metadata": {
                "labels": {
                  "app": "${deploymentName}"
                }
              },
              "spec": {
                "containers": [
                  {
                    "name": "${deploymentName}",
                    "image": "${image}",
                    "ports": [
                      {
                        "containerPort": "${containerPort}",
                        "protocol": "TCP"
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "actions": [
        { "type": "submit", "label": "\u521b\u5efa", "level": "primary" }
      ],
      "body": [
        {
          "type": "select",
          "name": "clusterCode",
          "label": "\u76ee\u6807\u96c6\u7fa4",
          "source": "${API_HOST}/cluster/options",
          "value": "cloud-main",
          "required": true
        },
        { "type": "input-text", "name": "deploymentName", "label": "Deployment \u540d\u79f0", "required": true },
        { "type": "input-text", "name": "namespace", "label": "Namespace", "required": true },
        {
          "type": "input-text",
          "name": "image",
          "label": "\u955c\u50cf",
          "value": "${params.image}",
          "required": true
        },
        { "type": "input-number", "name": "replicas", "label": "\u526f\u672c\u6570", "value": 1, "required": true },
        { "type": "input-number", "name": "containerPort", "label": "\u5bb9\u5668\u7aef\u53e3", "value": 8080, "required": true }
      ]
    }
  ]
}
