{
  "type": "page",
  "name": "page-image-list",
  "body": [
    {
      "type": "button",
      "label": "Create Image",
      "icon": "fas fa-plus",
      "size": "md",
      "level": "primary",
      "actionType": "link",
      "link": "/images/new"
    },
    {
      "type": "crud",
      "name": "image-list",
      "headerToolbar": [
        {
          "type": "reload",
          "align": "left",
          "icon": "iconfont icon-refresh",
          "label": "Refresh",
          "tooltip": "",
          "level": "primary"
        },
        {
          "type": "columns-toggler",
          "align": "right",
          "draggable": false,
          "icon": "fas fa-cog",
          "overlay": true,
          "footerBtnSize": "sm"
        }
      ],
      "api": {
        "url": "${API_HOST}/image/list",
        "method": "get"
      },
      "columns": [
        {
          "name": "user",
          "label": "User",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "image",
          "label": "Image",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "status",
          "label": "Status",
          "labelClassName": "font-bold",
          "align": "center",
          "classNameExpr": "<%= data.status === '可部署' ? 'text-info' : (data.status === '创建中' ? 'text-warning' : 'text-danger') %>"
        },
        {
          "name": "createTime",
          "label": "Created At",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "type": "operation",
          "label": "Actions",
          "labelClassName": "font-bold",
          "align": "center",
          "width": "",
          "buttons": [
            {
              "type": "button-group",
              "buttons": [
                {
                  "type": "button",
                  "label": "Deploy",
                  "level": "primary",
                  "visibleOn": "${status === '可部署'}",
                  "actionType": "link",
                  "link": "/deployments/new/${image}"
                },
                {
                  "type": "button",
                  "label": "Delete",
                  "level": "danger",
                  "actionType": "ajax",
                  "confirmText": "This will delete image ${image}. Continue?",
                  "api": {
                    "method": "get",
                    "url": "${API_HOST}/image/delete",
                    "data": {
                      "image": "${image}"
                    }
                  },
                  "reload": "image-list"
                }
              ]
            }
          ],
          "placeholder": "-",
          "fixed": "right"
        }
      ],
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "No data",
      "tableClassName": "table-db table-striped",
      "headerClassName": "crud-table-header",
      "footerClassName": "crud-table-footer",
      "toolbarClassName": "crud-table-toolbar",
      "combineNum": 1,
      "bodyClassName": "panel-default"
    }
  ]
}
