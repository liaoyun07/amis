{
  "type": "page",
  "name": "page-service-list",
  "body": [
    {
      "type": "button",
      "label": "\u521b\u5efa Service",
      "icon": "fas fa-plus",
      "size": "md",
      "level": "primary",
      "actionType": "link",
      "link": "/services/new"
    },
    {
      "type": "crud",
      "name": "service-list",
      "headerToolbar": [
        { "type": "reload", "align": "left", "icon": "iconfont icon-refresh", "label": "\u5237\u65b0", "level": "primary" },
        { "type": "columns-toggler", "align": "right", "icon": "fas fa-cog", "overlay": true }
      ],
      "api": {
        "url": "${API_HOST}/service/search/all",
        "method": "get"
      },
      "columns": [
        { "name": "clusterCode", "label": "\u96c6\u7fa4", "align": "center" },
        {
          "name": "clusterRole",
          "label": "\u89d2\u8272",
          "type": "mapping",
          "map": {
            "CLOUD": "\u4e2d\u5fc3\u4e91",
            "EDGE": "\u8fb9\u7f18\u4e91",
            "GENERAL": "\u901a\u7528\u96c6\u7fa4",
            "*": "${clusterRole}"
          },
          "align": "center"
        },
        { "name": "user", "label": "\u7528\u6237", "align": "center" },
        { "name": "namespace", "label": "Namespace", "align": "center" },
        { "name": "name", "label": "\u540d\u79f0", "align": "center" },
        { "name": "creationTime", "label": "\u521b\u5efa\u65f6\u95f4", "align": "center" },
        { "name": "type", "label": "\u670d\u52a1\u7c7b\u578b", "align": "center" },
        { "name": "ports", "label": "\u7aef\u53e3", "align": "center" },
        {
          "type": "operation",
          "label": "\u64cd\u4f5c",
          "align": "center",
          "buttons": [
            {
              "type": "button-group",
              "buttons": [
                {
                  "type": "button",
                  "label": "\u67e5\u770b\u8be6\u60c5",
                  "level": "primary",
                  "actionType": "link",
                  "link": "/service/${clusterCode}/${namespace}/${name}"
                },
                {
                  "type": "button",
                  "label": "\u5220\u9664",
                  "level": "danger",
                  "actionType": "ajax",
                  "confirmText": "\u786e\u5b9a\u5220\u9664 ${clusterCode}/${namespace}/${name} \u5417\uff1f",
                  "api": {
                    "method": "get",
                    "url": "${API_HOST}/service/delete",
                    "data": {
                      "clusterCode": "${clusterCode}",
                      "serviceName": "${name}",
                      "namespaceName": "${namespace}"
                    }
                  },
                  "reload": "service-list"
                }
              ]
            }
          ],
          "fixed": "right"
        }
      ],
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "\u6682\u65e0\u6570\u636e",
      "tableClassName": "table-db table-striped"
    }
  ]
}
