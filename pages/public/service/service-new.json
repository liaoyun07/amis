{
  "type": "page",
  "title": "\u521b\u5efa Service",
  "toolbar": [
    {
      "type": "button",
      "actionType": "link",
      "link": "/service",
      "label": "\u8fd4\u56de Service \u5217\u8868",
      "level": "primary"
    }
  ],
  "preventEnterSubmit": true,
  "body": [
    {
      "type": "form",
      "api": {
        "method": "post",
        "url": "${API_HOST}/service/add"
      },
      "redirect": "/service",
      "actions": [
        { "type": "submit", "label": "\u521b\u5efa", "level": "primary" }
      ],
      "body": [
        {
          "type": "select",
          "name": "clusterCode",
          "label": "\u76ee\u6807\u96c6\u7fa4",
          "source": "${API_HOST}/cluster/options",
          "value": "cloud-main",
          "required": true
        },
        {
          "type": "json-schema",
          "name": "metadata",
          "label": "metadata",
          "schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["namespace", "name", "labels"],
            "properties": {
              "name": { "type": "string", "title": "name" },
              "namespace": { "type": "string", "title": "namespace" },
              "labels": {
                "type": "object",
                "title": "labels",
                "additionalProperties": true
              }
            }
          }
        },
        {
          "type": "json-schema",
          "name": "spec",
          "label": "spec",
          "schema": {
            "type": "object",
            "title": "spec",
            "required": ["selector", "type", "ports"],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "title": "type",
                "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
              },
              "selector": {
                "type": "object",
                "title": "selector",
                "additionalProperties": true
              },
              "ports": {
                "type": "array",
                "title": "ports",
                "items": {
                  "type": "object",
                  "required": ["name", "port", "protocol", "targetPort"],
                  "additionalProperties": true,
                  "properties": {
                    "name": { "type": "string", "title": "name" },
                    "port": { "type": "number", "title": "port" },
                    "protocol": {
                      "type": "string",
                      "title": "protocol",
                      "enum": ["TCP", "UDP"]
                    },
                    "targetPort": { "type": "number", "title": "targetPort" },
                    "nodePort": { "type": "number", "title": "nodePort" }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
