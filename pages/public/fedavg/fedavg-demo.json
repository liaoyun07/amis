{
  "type": "page",
  "title": "FedAvg 联邦学习演示",
  "name": "page-fedavg-demo",
  "body": [
    {
      "type": "alert",
      "level": "info",
      "showCloseButton": false,
      "body": "本页面用于启动一个最小真实联邦学习任务：算法为 FedAvg，数据集可选择 MNIST / CIFAR-10，客户端可选择 MLP 或 SmallVGG，并支持 IID / Dirichlet 数据分片。请先确保 fedavg-server 与 fedavg-client 镜像已重新构建并推送到本地 registry。"
    },
    {
      "type": "grid",
      "columns": [
        {
          "md": 5,
          "body": [
            {
              "type": "form",
              "title": "创建训练任务",
              "name": "fedavg-start-form",
              "mode": "horizontal",
              "horizontal": {
                "left": 4,
                "right": 8
              },
              "api": {
                "method": "post",
                "url": "${API_HOST}/datastream/fedavg/start",
                "data": {
                  "taskName": "${taskName}",
                  "namespace": "${namespace}",
                  "serverImage": "${serverImage}",
                  "clientImage": "${clientImage}",
                  "dataset": "${dataset}",
                  "model": "${model}",
                  "clientCount": "${clientCount}",
                  "rounds": "${rounds}",
                  "partition": {
                    "strategy": "${partitionStrategy}",
                    "alpha": "${partitionAlpha}",
                    "seed": "${partitionSeed}"
                  },
                  "train": {
                    "localEpochs": "${localEpochs}",
                    "batchSize": "${batchSize}",
                    "learningRate": "${learningRate}",
                    "maxSamplesPerClient": "${maxSamplesPerClient}",
                    "participationRate": "${participationRate}",
                    "selectionSeed": "${selectionSeed}"
                  }
                },
                "adaptor": "return {\n  ...payload,\n  status: payload.status === 200 ? 0 : payload.status,\n  msg: payload.message,\n  data: payload.data\n};",
                "messages": {
                  "success": "FedAvg 任务已提交，稍后刷新任务列表查看状态。"
                }
              },
              "reload": "fedavg-task-list",
              "actions": [
                {
                  "type": "submit",
                  "label": "启动训练",
                  "level": "primary"
                },
                {
                  "type": "reset",
                  "label": "重置"
                }
              ],
              "body": [
                {
                  "type": "input-text",
                  "name": "taskName",
                  "label": "任务名称",
                  "value": "fedavg-demo",
                  "required": true
                },
                {
                  "type": "input-text",
                  "name": "namespace",
                  "label": "命名空间",
                  "value": "fedavg-demo",
                  "required": true
                },
                {
                  "type": "input-text",
                  "name": "serverImage",
                  "label": "服务端镜像",
                  "value": "fedavg-server",
                  "required": true,
                  "description": "可填写短镜像名，后端会补全为 gateway-registry:5000/xxx:latest。"
                },
                {
                  "type": "input-text",
                  "name": "clientImage",
                  "label": "客户端镜像",
                  "value": "fedavg-client",
                  "required": true
                },
                {
                  "type": "select",
                  "name": "dataset",
                  "label": "数据集",
                  "value": "mnist",
                  "required": true,
                  "options": [
                    {
                      "label": "MNIST",
                      "value": "mnist"
                    },
                    {
                      "label": "CIFAR-10",
                      "value": "cifar10"
                    }
                  ],
                  "description": "CIFAR-10 为 3 通道 32x32 彩色图像，训练会比 MNIST 更占内存和时间。"
                },
                {
                  "type": "select",
                  "name": "model",
                  "label": "网络结构",
                  "value": "mlp",
                  "required": true,
                  "options": [
                    {
                      "label": "MLP",
                      "value": "mlp"
                    },
                    {
                      "label": "SmallVGG",
                      "value": "small-vgg"
                    }
                  ]
                },
                {
                  "type": "input-number",
                  "name": "clientCount",
                  "label": "客户端数量",
                  "value": 2,
                  "min": 1,
                  "required": true
                },
                {
                  "type": "input-number",
                  "name": "rounds",
                  "label": "训练轮次",
                  "value": 3,
                  "min": 1,
                  "required": true
                },
                {
                  "type": "divider",
                  "title": "数据分片"
                },
                {
                  "type": "select",
                  "name": "partitionStrategy",
                  "label": "分片策略",
                  "value": "dirichlet",
                  "options": [
                    {
                      "label": "Dirichlet Non-IID",
                      "value": "dirichlet"
                    },
                    {
                      "label": "IID",
                      "value": "iid"
                    }
                  ]
                },
                {
                  "type": "input-number",
                  "name": "partitionAlpha",
                  "label": "Dirichlet Alpha",
                  "value": 0.5,
                  "min": 0.01,
                  "step": 0.1,
                  "precision": 2,
                  "visibleOn": "this.partitionStrategy === 'dirichlet'",
                  "description": "alpha 越小，客户端数据越不均衡；alpha 越大，越接近 IID。"
                },
                {
                  "type": "input-number",
                  "name": "partitionSeed",
                  "label": "随机种子",
                  "value": 42,
                  "min": 0
                },
                {
                  "type": "divider",
                  "title": "训练参数"
                },
                {
                  "type": "input-number",
                  "name": "participationRate",
                  "label": "每轮参与比例",
                  "value": 0.1,
                  "min": 0.01,
                  "max": 1,
                  "step": 0.01,
                  "precision": 2,
                  "description": "例如 0.1 表示每轮随机选择 10% 客户端参与训练；至少会选择 1 个客户端。"
                },
                {
                  "type": "input-number",
                  "name": "selectionSeed",
                  "label": "客户端抽样种子",
                  "value": 42,
                  "min": 0
                },
                {
                  "type": "input-number",
                  "name": "localEpochs",
                  "label": "本地 Epoch",
                  "value": 1,
                  "min": 1,
                  "max": 10
                },
                {
                  "type": "input-number",
                  "name": "batchSize",
                  "label": "Batch Size",
                  "value": 32,
                  "min": 1
                },
                {
                  "type": "input-number",
                  "name": "learningRate",
                  "label": "学习率",
                  "value": 0.01,
                  "min": 0.0001,
                  "step": 0.001,
                  "precision": 4
                },
                {
                  "type": "input-number",
                  "name": "maxSamplesPerClient",
                  "label": "每客户端样本上限",
                  "value": 600,
                  "min": 1,
                  "description": "用于控制演示训练耗时。设大一些更接近真实训练，但 Pod 运行会更慢。"
                }
              ]
            }
          ]
        },
        {
          "md": 7,
          "body": [
            {
              "type": "panel",
              "title": "验证说明",
              "body": [
                {
                  "type": "tpl",
                  "tpl": "<p>任务启动后会创建 1 个 server Deployment/Service，以及 N 个 client Deployment。Pod Running 后，可在本机执行：</p><pre>kubectl --kubeconfig F:\\Project\\IDEAProject\\gateway\\tools\\k3d-gateway-multi.yaml get pod,svc -n fedavg-demo -o wide</pre><p>如需查看聚合结果，先转发 server service：</p><pre>kubectl --kubeconfig F:\\Project\\IDEAProject\\gateway\\tools\\k3d-gateway-multi.yaml port-forward -n fedavg-demo svc/fedavg-demo-server 18090:8080</pre><p>然后访问：</p><pre>curl.exe http://127.0.0.1:18090/</pre>"
                }
              ]
            },
            {
              "type": "crud",
              "name": "fedavg-task-list",
              "title": "任务列表",
              "syncLocation": false,
              "api": {
                "method": "get",
                "url": "${API_HOST}/datastream/fedavg/list",
                "adaptor": "return {\n  ...payload,\n  status: payload.status === 200 ? 0 : payload.status,\n  msg: payload.message,\n  data: { items: payload.data || [] }\n};"
              },
              "headerToolbar": [
                {
                  "type": "reload",
                  "align": "left",
                  "label": "刷新",
                  "level": "primary",
                  "icon": "iconfont icon-refresh"
                }
              ],
              "columns": [
                {
                  "name": "taskName",
                  "label": "任务",
                  "align": "center"
                },
                {
                  "name": "namespace",
                  "label": "命名空间",
                  "align": "center"
                },
                {
                  "name": "status",
                  "label": "状态",
                  "align": "center",
                  "type": "mapping",
                  "map": {
                    "RUNNING": "<span class='label label-success'>RUNNING</span>",
                    "COMPLETED": "<span class='label label-success'>COMPLETED</span>",
                    "FAILED": "<span class='label label-danger'>FAILED</span>",
                    "DEPLOYING": "<span class='label label-warning'>DEPLOYING</span>",
                    "DEPLOYED": "<span class='label label-info'>DEPLOYED</span>",
                    "UNKNOWN": "<span class='label label-danger'>UNKNOWN</span>",
                    "*": "${status}"
                  }
                },
                {
                  "name": "dataset",
                  "label": "数据集",
                  "align": "center"
                },
                {
                  "name": "model",
                  "label": "网络",
                  "align": "center"
                },
                {
                  "name": "clientCount",
                  "label": "客户端",
                  "align": "center"
                },
                {
                  "name": "rounds",
                  "label": "轮次",
                  "align": "center"
                },
                {
                  "name": "partitionStrategy",
                  "label": "分片",
                  "align": "center"
                },
                {
                  "name": "partitionAlpha",
                  "label": "Alpha",
                  "align": "center"
                },
                {
                  "type": "operation",
                  "label": "操作",
                  "align": "center",
                  "buttons": [
                    {
                      "type": "button",
                      "label": "详情",
                      "level": "primary",
                      "actionType": "dialog",
                      "dialog": {
                        "title": "FedAvg 任务详情",
                        "body": [
                          {
                            "type": "json",
                            "name": "$$"
                          }
                        ]
                      }
                    },
                    {
                      "type": "button",
                      "label": "查看结果",
                      "level": "success",
                      "actionType": "dialog",
                      "dialog": {
                        "title": "FedAvg 训练结果 - ${taskName}",
                        "size": "lg",
                        "body": [
                          {
                            "type": "service",
                            "api": {
                              "method": "get",
                              "url": "${API_HOST}/datastream/fedavg/result?taskName=${taskName}",
                              "adaptor": "const data = payload.data || {};\nconst history = data.history || [];\nconst clientNames = Array.isArray(data.clients) && data.clients.length ? data.clients : Object.keys(data.clientInfo || {});\nconst roundLabels = history.map(item => `Round ${item.round}`);\nconst roundMetricMap = history.map(item => {\n  const map = {};\n  const clients = item.clients || [];\n  const metrics = item.metrics || [];\n  clients.forEach((client, index) => {\n    map[client] = metrics[index] || {};\n  });\n  return map;\n});\nconst avg = (values) => {\n  const nums = values.map(Number).filter(item => !Number.isNaN(item));\n  if (!nums.length) return 0;\n  return Number((nums.reduce((sum, item) => sum + item, 0) / nums.length).toFixed(6));\n};\nconst avgMetricValues = (key) => roundMetricMap.map(map => avg(clientNames.map(client => map[client] && map[client][key])));\ndata.metricRows = history.map((item, index) => ({\n  round: item.round,\n  avgLoss: avgMetricValues('loss')[index],\n  avgAccuracy: avgMetricValues('accuracy')[index],\n  samples: item.samples,\n  clients: item.clients,\n  metrics: item.metrics\n}));\ndata.lossChartConfig = {\n  tooltip: { trigger: 'axis' },\n  legend: { top: 0 },\n  grid: { left: 56, right: 28, bottom: 40, top: 64 },\n  xAxis: { type: 'category', boundaryGap: false, data: roundLabels },\n  yAxis: { type: 'value', name: 'Loss', scale: true },\n  series: [\n    { name: 'Average Loss', type: 'line', smooth: true, symbolSize: 7, lineStyle: { width: 4 }, data: avgMetricValues('loss') }\n  ]\n};\ndata.accuracyChartConfig = {\n  tooltip: { trigger: 'axis' },\n  legend: { top: 0 },\n  grid: { left: 56, right: 28, bottom: 40, top: 64 },\n  xAxis: { type: 'category', boundaryGap: false, data: roundLabels },\n  yAxis: { type: 'value', name: 'Accuracy', min: 0, max: 1 },\n  series: [\n    { name: 'Average Accuracy', type: 'line', smooth: true, symbolSize: 7, lineStyle: { width: 4 }, data: avgMetricValues('accuracy') }\n  ]\n};\nreturn {\n  ...payload,\n  status: payload.status === 200 ? 0 : payload.status,\n  msg: payload.message,\n  data\n};"
                            },
                            "body": [
                              {
                                "type": "cards",
                                "source": "$$",
                                "placeholder": "",
                                "columnsCount": 4,
                                "card": {
                                  "body": [
                                    {
                                      "type": "tpl",
                                      "tpl": "<strong>算法</strong><br>${algorithm|default:-}"
                                    }
                                  ]
                                },
                                "visibleOn": "false"
                              },
                              {
                                "type": "grid",
                                "columns": [
                                  {
                                    "md": 3,
                                    "body": {
                                      "type": "tpl",
                                      "tpl": "<div class='b-a p-3'><div class='text-muted'>状态</div><h3>${status|default:-}</h3></div>"
                                    }
                                  },
                                  {
                                    "md": 3,
                                    "body": {
                                      "type": "tpl",
                                      "tpl": "<div class='b-a p-3'><div class='text-muted'>数据集 / 模型</div><h3>${dataset|default:-} / ${model|default:-}</h3></div>"
                                    }
                                  },
                                  {
                                    "md": 3,
                                    "body": {
                                      "type": "tpl",
                                      "tpl": "<div class='b-a p-3'><div class='text-muted'>当前轮次</div><h3>${currentRound|default:0} / ${rounds|default:0}</h3></div>"
                                    }
                                  },
                                  {
                                    "md": 3,
                                    "body": {
                                      "type": "tpl",
                                      "tpl": "<div class='b-a p-3'><div class='text-muted'>模型参数量</div><h3>${globalWeightCount|default:0}</h3></div>"
                                    }
                                  }
                                ]
                              },
                              {
                                "type": "divider",
                                "title": "Loss 曲线"
                              },
                              {
                                "type": "chart",
                                "height": 320,
                                "api": {
                                  "method": "get",
                                  "url": "${API_HOST}/datastream/fedavg/result?taskName=${taskName}",
                                  "adaptor": "const data = payload.data || {};\nconst history = data.history || [];\nconst clientNames = Array.isArray(data.clients) && data.clients.length ? data.clients : Object.keys(data.clientInfo || {});\nconst roundLabels = history.map(item => `Round ${item.round}`);\nconst roundMetricMap = history.map(item => {\n  const map = {};\n  const clients = item.clients || [];\n  const metrics = item.metrics || [];\n  clients.forEach((client, index) => { map[client] = metrics[index] || {}; });\n  return map;\n});\nconst avg = values => {\n  const nums = values.map(Number).filter(item => !Number.isNaN(item));\n  if (!nums.length) return null;\n  return Number((nums.reduce((sum, item) => sum + item, 0) / nums.length).toFixed(6));\n};\nconst option = {\n  tooltip: { trigger: 'axis' },\n  legend: { top: 0 },\n  grid: { left: 56, right: 28, bottom: 40, top: 64 },\n  xAxis: { type: 'category', boundaryGap: false, data: roundLabels },\n  yAxis: { type: 'value', name: 'Loss', scale: true },\n  series: [\n    { name: 'Average Loss', type: 'line', smooth: true, symbolSize: 7, lineStyle: { width: 4 }, data: roundMetricMap.map(map => avg(clientNames.map(client => map[client] && map[client].loss))) }\n  ]\n};\nreturn { status: 0, msg: payload.message, data: option };"
                                },
                                "placeholder": "暂无 Loss 曲线数据"
                              },
                              {
                                "type": "divider",
                                "title": "Accuracy 曲线"
                              },
                              {
                                "type": "chart",
                                "height": 320,
                                "api": {
                                  "method": "get",
                                  "url": "${API_HOST}/datastream/fedavg/result?taskName=${taskName}",
                                  "adaptor": "const data = payload.data || {};\nconst history = data.history || [];\nconst clientNames = Array.isArray(data.clients) && data.clients.length ? data.clients : Object.keys(data.clientInfo || {});\nconst roundLabels = history.map(item => `Round ${item.round}`);\nconst roundMetricMap = history.map(item => {\n  const map = {};\n  const clients = item.clients || [];\n  const metrics = item.metrics || [];\n  clients.forEach((client, index) => { map[client] = metrics[index] || {}; });\n  return map;\n});\nconst avg = values => {\n  const nums = values.map(Number).filter(item => !Number.isNaN(item));\n  if (!nums.length) return null;\n  return Number((nums.reduce((sum, item) => sum + item, 0) / nums.length).toFixed(6));\n};\nconst option = {\n  tooltip: { trigger: 'axis' },\n  legend: { top: 0 },\n  grid: { left: 56, right: 28, bottom: 40, top: 64 },\n  xAxis: { type: 'category', boundaryGap: false, data: roundLabels },\n  yAxis: { type: 'value', name: 'Accuracy', min: 0, max: 1 },\n  series: [\n    { name: 'Average Accuracy', type: 'line', smooth: true, symbolSize: 7, lineStyle: { width: 4 }, data: roundMetricMap.map(map => avg(clientNames.map(client => map[client] && map[client].accuracy))) }\n  ]\n};\nreturn { status: 0, msg: payload.message, data: option };"
                                },
                                "placeholder": "暂无 Accuracy 曲线数据"
                              },
                              {
                                "type": "table",
                                "source": "${metricRows}",
                                "placeholder": "暂无指标数据",
                                "columns": [
                                  {
                                    "name": "round",
                                    "label": "轮次"
                                  },
                                  {
                                    "name": "avgLoss",
                                    "label": "平均 Loss"
                                  },
                                  {
                                    "name": "avgAccuracy",
                                    "label": "平均 Accuracy"
                                  },
                                  {
                                    "name": "samples",
                                    "label": "样本数"
                                  }
                                ]
                              },
                              {
                                "type": "divider",
                                "title": "最终全局权重预览"
                              },
                              {
                                "type": "json",
                                "name": "globalWeightsPreview",
                                "placeholder": "暂无全局权重"
                              },
                              {
                                "type": "divider",
                                "title": "客户端数据分布"
                              },
                              {
                                "type": "json",
                                "name": "clientInfo",
                                "placeholder": "暂无客户端分布"
                              },
                              {
                                "type": "divider",
                                "title": "Pod Node 分配"
                              },
                              {
                                "type": "table",
                                "source": "${podPlacements}",
                                "placeholder": "暂无 Pod 分配信息",
                                "columns": [
                                  {
                                    "name": "role",
                                    "label": "角色"
                                  },
                                  {
                                    "name": "clientId",
                                    "label": "客户端 / 服务"
                                  },
                                  {
                                    "name": "podName",
                                    "label": "Pod"
                                  },
                                  {
                                    "name": "nodeName",
                                    "label": "Node"
                                  },
                                  {
                                    "name": "phase",
                                    "label": "状态"
                                  },
                                  {
                                    "name": "ready",
                                    "label": "Ready"
                                  },
                                  {
                                    "name": "podIp",
                                    "label": "Pod IP"
                                  },
                                  {
                                    "name": "hostIp",
                                    "label": "Node IP"
                                  }
                                ]
                              },
                              {
                                "type": "divider",
                                "title": "每轮训练指标"
                              },
                              {
                                "type": "table",
                                "source": "${history}",
                                "placeholder": "暂无训练历史",
                                "columns": [
                                  {
                                    "name": "round",
                                    "label": "轮次"
                                  },
                                  {
                                    "name": "samples",
                                    "label": "样本数"
                                  },
                                  {
                                    "name": "selectedClients",
                                    "label": "本轮选中客户端",
                                    "type": "json"
                                  },
                                  {
                                    "name": "clients",
                                    "label": "实际上报客户端",
                                    "type": "json"
                                  },
                                  {
                                    "name": "metrics",
                                    "label": "Loss / Accuracy",
                                    "type": "json"
                                  },
                                  {
                                    "name": "globalWeightsPreview",
                                    "label": "权重预览",
                                    "type": "json"
                                  }
                                ]
                              },
                              {
                                "type": "divider",
                                "title": "原始结果"
                              },
                              {
                                "type": "json",
                                "name": "$$"
                              }
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "type": "button",
                      "label": "删除",
                      "level": "danger",
                      "actionType": "ajax",
                      "confirmText": "确认删除任务 ${taskName} 的 server/client Deployment 和 Service？",
                      "api": {
                        "method": "get",
                        "url": "${API_HOST}/datastream/fedavg/delete?taskName=${taskName}",
                        "adaptor": "return {\n  ...payload,\n  status: payload.status === 200 ? 0 : payload.status,\n  msg: payload.message,\n  data: payload.data\n};"
                      },
                      "reload": "fedavg-task-list"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
