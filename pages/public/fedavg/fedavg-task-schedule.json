{
  "type": "page",
  "title": "任务调度",
  "body": [
    {
      "type": "alert",
      "level": "info",
      "showCloseButton": false,
      "body": "这里展示已创建任务的运行状态、Pod 落点和资源释放情况。"
    },
    {
      "type": "crud",
      "name": "fedavg-task-schedule-list",
      "title": "任务调度列表",
          "syncLocation": false,
          "api": {
            "method": "get",
            "url": "${API_HOST}/datastream/fedavg/list",
            "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: { items: payload.data || [] } };"
          },
          "headerToolbar": [
            {
              "type": "reload",
              "label": "刷新",
              "level": "primary"
            }
          ],
          "columns": [
            {
              "name": "algorithm",
              "label": "算法",
              "align": "center"
            },
            {
              "name": "taskName",
              "label": "任务名称",
              "align": "center"
            },
            {
              "name": "namespace",
              "label": "命名空间",
              "align": "center"
            },
            {
              "name": "status",
              "label": "状态",
              "align": "center",
              "type": "mapping",
              "map": {
                "RUNNING": "<span class='label label-success'>RUNNING</span>",
                "COMPLETED": "<span class='label label-default'>COMPLETED</span>",
                "FAILED": "<span class='label label-danger'>FAILED</span>",
                "DEPLOYING": "<span class='label label-warning'>DEPLOYING</span>",
                "DEPLOYED": "<span class='label label-info'>DEPLOYED</span>",
                "UNKNOWN": "<span class='label label-danger'>UNKNOWN</span>",
                "*": "${status}"
              }
            },
            {
              "name": "clientCount",
              "label": "客户端数量",
              "align": "center"
            },
            {
              "name": "rounds",
              "label": "轮数",
              "align": "center"
            },
            {
              "name": "serverService",
              "label": "服务端 Service",
              "align": "center"
            },
            {
              "type": "operation",
              "label": "操作",
              "align": "center",
              "buttons": [
                {
                  "type": "button",
                  "label": "查看调度",
                  "level": "primary",
                  "actionType": "dialog",
                  "dialog": {
                    "title": "任务调度 - ${taskName}",
                    "size": "lg",
                    "body": {
                      "type": "service",
                      "api": {
                        "method": "get",
                        "url": "${API_HOST}/datastream/fedavg/result?taskName=${taskName}",
                        "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: payload.data || {} };"
                      },
                      "body": [
                        {
                          "type": "grid",
                          "columns": [
                            {
                              "md": 4,
                              "body": {
                                "type": "tpl",
                                "tpl": "<div class='b-a p-3'><div class='text-muted'>状态</div><h3>${status|default:-}</h3></div>"
                              }
                            },
                            {
                              "md": 4,
                              "body": {
                                "type": "tpl",
                                "tpl": "<div class='b-a p-3'><div class='text-muted'>当前轮次</div><h3>${currentRound|default:0} / ${rounds|default:0}</h3></div>"
                              }
                            },
                            {
                              "md": 4,
                              "body": {
                                "type": "tpl",
                                "tpl": "<div class='b-a p-3'><div class='text-muted'>资源是否已释放</div><h3>${resourcesReleased ? '是' : '否'}</h3></div>"
                              }
                            }
                          ]
                        },
                        {
                          "type": "divider",
                          "title": "Pod 分配"
                        },
                        {
                          "type": "table",
                          "source": "${podPlacements}",
                          "placeholder": "暂无 Pod 分配数据",
                          "columns": [
                            { "name": "clusterCode", "label": "集群" },
                            { "name": "role", "label": "角色" },
                            { "name": "clientId", "label": "工作负载" },
                            { "name": "podName", "label": "Pod" },
                            { "name": "nodeName", "label": "节点" },
                            { "name": "phase", "label": "阶段" },
                            { "name": "ready", "label": "Ready" },
                            { "name": "podIp", "label": "Pod IP" },
                            { "name": "hostIp", "label": "节点 IP" }
                          ]
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "button",
                  "label": "删除",
                  "level": "danger",
                  "actionType": "ajax",
                  "confirmText": "确认删除任务 ${taskName} 并释放其运行资源？",
                  "api": {
                    "method": "get",
                    "url": "${API_HOST}/datastream/fedavg/delete?taskName=${taskName}",
                    "adaptor": "return { ...payload, status: payload.status === 200 ? 0 : payload.status, msg: payload.message, data: payload.data };"
                  },
                  "reload": "fedavg-task-schedule-list"
                }
              ]
            }
          ]
    }
  ]
}
