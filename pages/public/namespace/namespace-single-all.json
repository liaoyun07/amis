{
  "type": "page",
  "title": "${params.clusterCode}/${params.name}",
  "initApi": {
    "url": "${API_HOST}/namespace/search/single",
    "data": {
      "clusterCode": "${params.clusterCode}",
      "name": "${params.name}"
    },
    "method": "get",
    "adaptor": "return {\n  ...payload,\n  status: payload.status === 200 ? 0 : payload.status,\n  msg: payload.message,\n  data: {response: payload.data}\n}"
  },
  "toolbar": [
    {
      "type": "button",
      "actionType": "link",
      "link": "/namespace",
      "label": "\u8fd4\u56de Namespace \u5217\u8868",
      "level": "primary",
      "size": "lg"
    }
  ],
  "body": [
    {
      "type": "control",
      "name": "response",
      "body": {
        "type": "json",
        "jsonTheme": "eighties",
        "levelExpand": 100
      }
    }
  ]
}
