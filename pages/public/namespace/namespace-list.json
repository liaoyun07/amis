{
  "type": "page",
  "name": "page-namespace-list",
  "body": [
    {
      "type": "button",
      "label": "\u521b\u5efa Namespace",
      "icon": "fas fa-plus",
      "size": "md",
      "level": "primary",
      "actionType": "dialog",
      "dialog": {
        "type": "dialog",
        "title": "\u521b\u5efa Namespace",
        "body": [
          {
            "type": "form",
            "api": {
              "method": "get",
              "url": "${API_HOST}/namespace/add",
              "data": {
                "clusterCode": "${clusterCode}",
                "name": "${name}"
              }
            },
            "body": [
              {
                "label": "\u76ee\u6807\u96c6\u7fa4",
                "type": "select",
                "name": "clusterCode",
                "source": "${API_HOST}/cluster/options",
                "value": "cloud-main",
                "required": true
              },
              {
                "label": "\u540d\u79f0",
                "type": "input-text",
                "name": "name",
                "required": true
              }
            ]
          }
        ],
        "actions": [
          {
            "type": "submit",
            "label": "\u521b\u5efa",
            "actionType": "submit",
            "level": "info"
          }
        ]
      }
    },
    {
      "type": "crud",
      "name": "namespace-list",
      "headerToolbar": [
        {
          "type": "reload",
          "align": "left",
          "icon": "iconfont icon-refresh",
          "label": "\u5237\u65b0",
          "level": "primary"
        },
        {
          "type": "columns-toggler",
          "align": "right",
          "icon": "fas fa-cog",
          "overlay": true
        }
      ],
      "api": {
        "url": "${API_HOST}/namespace/search/all",
        "method": "get"
      },
      "columns": [
        { "name": "clusterCode", "label": "\u96c6\u7fa4", "align": "center" },
        {
          "name": "clusterRole",
          "label": "\u89d2\u8272",
          "type": "mapping",
          "map": {
            "CLOUD": "\u4e2d\u5fc3\u4e91",
            "EDGE": "\u8fb9\u7f18\u4e91",
            "GENERAL": "\u901a\u7528\u96c6\u7fa4",
            "*": "${clusterRole}"
          },
          "align": "center"
        },
        { "name": "user", "label": "\u7528\u6237", "align": "center" },
        { "name": "name", "label": "\u540d\u79f0", "align": "center" },
        { "name": "creationTime", "label": "\u521b\u5efa\u65f6\u95f4", "align": "center" },
        { "name": "status", "label": "\u72b6\u6001", "align": "center" },
        {
          "type": "operation",
          "label": "\u64cd\u4f5c",
          "align": "center",
          "buttons": [
            {
              "type": "button-group",
              "buttons": [
                {
                  "type": "button",
                  "label": "\u67e5\u770b\u8be6\u60c5",
                  "level": "primary",
                  "actionType": "link",
                  "link": "/namespace/${clusterCode}/${name}"
                },
                {
                  "type": "button",
                  "label": "\u5220\u9664",
                  "level": "danger",
                  "actionType": "ajax",
                  "confirmText": "\u786e\u5b9a\u5220\u9664 ${clusterCode}/${name} \u5417\uff1f",
                  "api": {
                    "method": "get",
                    "url": "${API_HOST}/namespace/delete",
                    "data": {
                      "clusterCode": "${clusterCode}",
                      "name": "${name}"
                    }
                  },
                  "reload": "namespace-list"
                }
              ]
            }
          ],
          "fixed": "right"
        }
      ],
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "\u6682\u65e0\u6570\u636e",
      "tableClassName": "table-db table-striped"
    }
  ]
}
