{
  "type": "page",
  "title": "${params.clusterCode}/${params.name}",
  "remark": null,
  "initApi": {
    "url": "${API_HOST}/node/search/single/all",
    "data": {
      "clusterCode": "${params.clusterCode}",
      "nodeName": "${params.name}"
    },
    "method": "get",
    "adaptor": "return {\n    ...payload,\n    status: payload.status === 200 ? 0 : payload.status,\n    msg: payload.message,\n    data: {response: payload.data}\n}"
  },
  "toolbar": [
    {
      "type": "button",
      "actionType": "link",
      "link": "/node",
      "label": "\u8fd4\u56de Node \u5217\u8868",
      "level": "primary",
      "size": "lg"
    }
  ],
  "body": [
    {
      "type": "control",
      "name": "response",
      "body": {
        "type": "json",
        "jsonTheme": "eighties",
        "levelExpand": 100
      }
    }
  ]
}
