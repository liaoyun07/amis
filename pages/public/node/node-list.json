{
  "type": "page",
  "name": "page-node-list",
  "body": [
    {
      "type": "crud",
      "name": "node-list",
      "headerToolbar": [
        {
          "type": "reload",
          "align": "left",
          "icon": "iconfont icon-refresh",
          "label": "\u5237\u65b0",
          "level": "primary"
        },
        {
          "type": "columns-toggler",
          "align": "right",
          "draggable": false,
          "icon": "fas fa-cog",
          "overlay": true,
          "footerBtnSize": "sm"
        }
      ],
      "api": {
        "url": "${API_HOST}/node/search/all",
        "method": "get"
      },
      "columns": [
        {
          "name": "clusterCode",
          "label": "\u96c6\u7fa4",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "clusterRole",
          "label": "\u89d2\u8272",
          "type": "mapping",
          "map": {
            "CLOUD": "\u4e2d\u5fc3\u4e91",
            "EDGE": "\u8fb9\u7f18\u4e91",
            "GENERAL": "\u901a\u7528\u96c6\u7fa4",
            "*": "${clusterRole}"
          },
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "name",
          "label": "\u540d\u79f0",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "creationTime",
          "label": "\u521b\u5efa\u65f6\u95f4",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "internalIp",
          "label": "\u8282\u70b9 IP",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "podCidr",
          "label": "Pod CIDR",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "status",
          "label": "\u72b6\u6001",
          "type": "mapping",
          "map": {
            "READY": "<span class='label label-success'>READY</span>",
            "NOT_READY": "<span class='label label-warning'>NOT_READY</span>",
            "UNAVAILABLE": "<span class='label label-danger'>UNAVAILABLE</span>",
            "*": "<span class='label label-default'>${status}</span>"
          },
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "type": "operation",
          "label": "\u64cd\u4f5c",
          "labelClassName": "font-bold",
          "align": "center",
          "buttons": [
            {
              "type": "button-group",
              "buttons": [
                {
                  "type": "button",
                  "label": "\u67e5\u770b\u8be6\u60c5",
                  "level": "primary",
                  "actionType": "link",
                  "link": "/node/${clusterCode}/${name}",
                  "visibleOn": "this.status !== 'UNAVAILABLE'"
                }
              ]
            }
          ],
          "placeholder": "-",
          "fixed": "right"
        }
      ],
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "\u6682\u65e0\u6570\u636e",
      "tableClassName": "table-db table-striped",
      "headerClassName": "crud-table-header",
      "footerClassName": "crud-table-footer",
      "toolbarClassName": "crud-table-toolbar",
      "combineNum": 0,
      "bodyClassName": "panel-default"
    }
  ]
}
