{
  "type": "page",
  "name": "page-node-list",
  "body": [
    {
      "type": "crud",
      "name": "node-list",
      "headerToolbar": [
        {
          "type": "reload",
          "align": "left",
          "icon": "iconfont icon-refresh",
          "label": "刷新",
          "tooltip": "",
          "level": "primary"
        },
        {
          "type": "columns-toggler",
          "align": "right",
          "draggable": false,
          "icon": "fas fa-cog",
          "overlay": true,
          "footerBtnSize": "sm"
        }
      ],
      "api": {
        "url": "${API_HOST}/node/search/all",
        "method": "get",
        "adaptor": "return {\n    ...payload,\n    status: payload.status === 200 ? 0 : payload.status,\n    msg: payload.message,\n    data: payload.data\n}"
      },
      "columns": [
        {
          "name": "name",
          "label": "名称",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "creationTime",
          "label": "创建时间",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "internalIp",
          "label": "集群内ip",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "podCidr",
          "label": "pod地址",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "name": "status",
          "label": "状态",
          "labelClassName": "font-bold",
          "align": "center"
        },
        {
          "type": "operation",
          "label": "操作",
          "labelClassName": "font-bold",
          "align": "center",
          "width": "",
          "buttons": [
            {
              "type": "button-group",
              "buttons": [
                {
                  "type": "button",
                  "label": "查看详情",
                  "level": "primary",
                  "actionType": "link",
                  "link": "/node/${name}"
                }
              ]
            }
          ],
          "placeholder": "-",
          "fixed": "right"
        }
      ],
      "affixHeader": true,
      "columnsTogglable": "auto",
      "placeholder": "暂无数据",
      "tableClassName": "table-db table-striped",
      "headerClassName": "crud-table-header",
      "footerClassName": "crud-table-footer",
      "toolbarClassName": "crud-table-toolbar",
      "combineNum": 0,
      "bodyClassName": "panel-default"
    }
  ]
}
